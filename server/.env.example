PORT=3000
# Разрешённые origin'ы сайта (через запятую), напр. https://вашдомен.ru
# Пусто = разрешить всё (только для локальной разработки).
ALLOWED_ORIGINS=https://вашдомен.ру

# OnlySq API 2.0 (см. docs_onlysq.txt в корне репо; рабочий домен — api.onlysq.me, НЕ .ru)
# Ключ "openai" больше НЕ поддерживается — нужен персональный ключ из профиля OnlySq.
ONLYSQ_BASE_URL=https://api.onlysq.me/ai/v2
ONLYSQ_API_KEY=sq-ваш-персональный-ключ
# deepseek-v4-pro — единственная стабильно рабочая модель на момент 2026-07-22 (см. /ai/models)
ONLYSQ_MODEL=deepseek-v4-pro
# reasoning-модели отвечают медленно, поэтому таймаут увеличен
ONLYSQ_TIMEOUT_MS=45000
